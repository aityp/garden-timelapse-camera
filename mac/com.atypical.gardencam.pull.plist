<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atypical.gardencam.pull</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOU/garden-cam/pull.sh</string>
    </array>

    <!-- Fire the moment any volume mounts. pull.sh checks it's the right drive. -->
    <key>StartOnMount</key>
    <true/>

    <!-- Backstop: also every hour while the drive stays connected. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- And once when you log in. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOU/Library/Logs/gardencam-pull.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/Library/Logs/gardencam-pull.err.log</string>
</dict>
</plist>
